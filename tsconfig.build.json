  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "tests",
    "src/client/CodexAssistantNodeView.tsx",
    "src/client/CodexSettingsCard.tsx",
    "src/client/settings-card-controller.ts",
    "src/client/locales.ts"
  ]
}
