{
  "name": "dsh-codex-native",
  "version": "0.2.1-alpha.9-http.4",
  "description": "Codex app-server main models for DSH with ChatGPT sign-in, Token history, context management and native tools.",
  "type": "module",
  "icon": "assets/chatgpt-auth.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/dsh-codex-native.git"
  },
  "homepage": "https://github.com/Tests4gptplay/dsh-codex-native#readme",
  "bugs": {
    "url": "https://github.com/Tests4gptplay/dsh-codex-native/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "locale/*.json",
    "assets/chatgpt-auth.png",
    "assets/LOBE-ICONS-LICENSE.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "codex",
    "llm",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-working-directory": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "*",
    "@deepseek-ai/dsh-client-connection": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@openai/codex": "0.154.0"
  }
}